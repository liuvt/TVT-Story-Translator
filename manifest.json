{
  "manifest_version": 3,
  "name": "TVT Story Translator - TTS",
  "short_name": "TVT Translator",
  "description": "Dịch, hiệu đính và định dạng truyện cho TTS theo phong cách tùy chỉnh, hỗ trợ Chrome Side Panel.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "contextMenus"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "TVT Story Translator - Mở bảng xử lý"},
  "side_panel": {"default_path": "panel.html"},
  "options_page": "options.html",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
